<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_graph_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_graph_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ESTROCURVE // 10D DYNAMICS"
            android:textColor="@color/widget_text_muted"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <!-- Legend Items -->
        <TextView
            android:id="@+id/widget_legend_e2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● E2"
            android:textColor="@color/widget_e2_pink"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_legend_t"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="● T"
            android:textColor="@color/widget_t_cyan"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_legend_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="┆ NOW"
            android:textColor="@color/widget_text_muted"
            android:textSize="8.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subtitle with live values -->
    <TextView
        android:id="@+id/widget_graph_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Now: -- pg/mL | T: --"
        android:textColor="@color/widget_text_secondary"
        android:textSize="10sp" />

    <!-- Graph Canvas Render Image -->
    <ImageView
        android:id="@+id/widget_graph_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Hormone dynamics curve graph"
        android:scaleType="fitXY" />

</LinearLayout>
